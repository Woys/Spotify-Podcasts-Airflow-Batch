# Copy to .env, keep mode 600, and replace every placeholder before startup.
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=replace-with-non-default-admin
_AIRFLOW_WWW_USER_PASSWORD=replace-with-at-least-20-random-characters
AIRFLOW__API__SECRET_KEY=replace-with-64-random-characters
AIRFLOW__API_AUTH__JWT_SECRET=replace-with-64-random-characters
AIRFLOW__CORE__FERNET_KEY=replace-with-a-valid-fernet-key
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-password

# Add only the Airflow Variables and Connections required by this deployment.
AIRFLOW_VAR_SP_S3_BUCKET=replace-with-bucket
AIRFLOW_CONN_AWS_CONN=replace-with-an-airflow-connection-uri-or-json
